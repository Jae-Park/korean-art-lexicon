# Korean Art Lexicon miner — 환경설정 (이 파일을 .env로 복사해 채운다; .env는 gitignore됨)

# Notion "Lexicon Candidates" DB (미설정 시 push는 no-op → dry-run으로만 동작)
NOTION_TOKEN=
NOTION_CANDIDATES_DB_ID=

# LLM 교차검증 모델 (구독 claude -p 기본값 사용하려면 비워둠). 예: claude-sonnet-4-6
MINER_MODEL=

# 🔒 API 종량 차단 가드. miner는 구독 claude -p / codex만 쓴다.
# 이 값이 "1"이 아니면 Anthropic API SDK 경로는 throw (bot-fleet 표준).
ALLOW_ANTHROPIC_API=0

# 번역 DB 추출기 (Claude-Custom, Synology 동기화). 머신별 경로 다르면 여기서 override.
ARCHIVE_EXTRACT_PY=
