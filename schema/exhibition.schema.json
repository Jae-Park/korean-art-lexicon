{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://korean-art-lexicon.org/schema/exhibition.schema.json",
  "title": "Exhibition",
  "description": "An exhibition entity in the Korean Art Lexicon",
  "type": "object",
  "required": ["id", "title", "sources"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^exhibition\\.[a-z0-9-]+$",
      "description": "Unique identifier in format: exhibition.{slug}"
    },
    "title": {
      "type": "object",
      "required": ["ko"],
      "additionalProperties": false,
      "properties": {
        "ko": {
          "type": "string",
          "minLength": 1,
          "description": "Korean title"
        },
        "en": {
          "type": "string",
          "minLength": 1,
          "description": "English title"
        },
        "note": {
          "type": "string",
          "description": "Note about title (e.g. 공식 한국어 제목 미발견)"
        },
        "variants": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["form", "lang"],
            "additionalProperties": false,
            "properties": {
              "form": {
                "type": "string",
                "minLength": 1,
                "description": "The title variant string"
              },
              "lang": {
                "type": "string",
                "description": "ISO 639-1 language code"
              },
              "script": {
                "type": "string",
                "enum": ["Hang", "Hani", "Kore", "Latn", "Jpan", "Hans", "Hant"],
                "description": "ISO 15924 script code"
              },
              "type": {
                "type": "string",
                "enum": ["preferred", "alternate", "abbreviation", "former", "transliteration"],
                "description": "Variant type"
              },
              "source": {
                "type": "string",
                "description": "Institution or publication where this variant is used"
              },
              "accessed": {
                "type": "string",
                "format": "date",
                "description": "Date the source was last accessed (YYYY-MM-DD)"
              }
            }
          },
          "description": "Title variants with language, script, and provenance"
        }
      }
    },
    "venue": {
      "type": "string",
      "description": "Exhibition venue"
    },
    "city": {
      "type": "string",
      "description": "City where the exhibition took place"
    },
    "country": {
      "type": "string",
      "description": "Country code (ISO 3166-1 alpha-2)"
    },
    "dates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "string",
          "format": "date",
          "description": "Opening date (YYYY-MM-DD)"
        },
        "end": {
          "type": "string",
          "format": "date",
          "description": "Closing date (YYYY-MM-DD)"
        },
        "year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100,
          "description": "Year only (when exact dates unknown)"
        }
      }
    },
    "type": {
      "type": "object",
      "required": ["aat"],
      "additionalProperties": false,
      "properties": {
        "aat": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "description": "Getty AAT Subject ID for the exhibition type"
        }
      },
      "description": "Exhibition type as Getty AAT ID"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^person\\.[a-z0-9-]+$"
      },
      "description": "References to person entities"
    },
    "curators": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^person\\.[a-z0-9-]+$"
      },
      "description": "References to curator/commissioner person entities"
    },
    "organizer": {
      "type": "string",
      "description": "Organizing institution or curator"
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(person|org|term|exhibition|publication)\\.[a-z0-9-]+$"
      },
      "description": "Related entities"
    },
    "external_ids": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wikidata": {
          "type": "string",
          "pattern": "^Q[0-9]+$",
          "description": "Wikidata Q-item ID"
        },
        "aaa": {
          "type": "string",
          "description": "Asia Art Archive event ID"
        }
      },
      "description": "Links to external databases"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "required": ["url"],
            "additionalProperties": false,
            "properties": {
              "url": {
                "type": "string",
                "minLength": 1
              },
              "name_used": {
                "type": "string",
                "description": "Name/title form used in this source"
              },
              "note": {
                "type": "string"
              },
              "accessed": {
                "type": "string",
                "format": "date",
                "description": "Date the source was last accessed (YYYY-MM-DD)"
              }
            }
          }
        ]
      },
      "description": "Verifiable sources for this entry"
    },
    "status": {
      "type": "string",
      "enum": ["submitted", "pending_review", "reviewed", "firsthand", "stable", "rejected"],
      "default": "draft",
      "description": "Entry status"
    },
    "notes": {
      "type": "string",
      "description": "Internal notes (optional)"
    }
  }
}
